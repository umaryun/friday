# Copy to .env and fill in.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main model, plus backups tried when it is busy. Change if Google renames or retires them.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Long random secret. The iPhone Shortcut and the Mac agent both send it.
JARVIS_TOKEN=

# Random topic name for push notifications. Subscribe to it in the ntfy iPhone app.
NTFY_TOPIC=

# Read messages back and wait for "yes" before sending (true/false).
CONFIRM_BEFORE_SEND=true

# Your timezone, e.g. Africa/Lagos. Required on the cloud server (it runs in UTC).
TIMEZONE=

# Country code added to local numbers that start with 0, digits only (e.g. 234).
DEFAULT_COUNTRY_CODE=

# Mac agent only: where the server is. localhost while testing, your cloud URL later.
JARVIS_SERVER_URL=http://localhost:8787
PROJECTS_DIR=~/Desktop/code

# Mac agent only: long-lived Claude Code login (README step 4).
CLAUDE_CODE_OAUTH_TOKEN=

# What the assistant calls itself. Match it to your Shortcut's name.
ASSISTANT_NAME=Friday

# Keep listening after each reply so you can carry on talking.
FOLLOW_UPS=true
# Calling again within this many minutes continues the same conversation.
CONVERSATION_IDLE_MINUTES=15

# GitHub (fine-grained personal access token, used by the GitHub MCP server)
GITHUB_TOKEN=
